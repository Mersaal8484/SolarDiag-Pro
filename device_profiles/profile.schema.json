{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solardiag.local/schemas/device-profile-v2.json",
  "title": "SolarDiag device profile v2",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "category",
    "manufacturer",
    "family",
    "models",
    "firmware_ranges",
    "simulated",
    "provenance",
    "transport",
    "capabilities",
    "allowed_read_frames",
    "allowed_modbus_read_ranges",
    "telemetry_map",
    "alarm_dictionary",
    "parameters",
    "topology",
    "inverter_link",
    "test_vectors",
    "connection_checklist"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "enum": ["battery", "inverter"]},
    "manufacturer": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "firmware_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "simulated": {"type": "boolean"},
    "provenance": {"type": "object"},
    "transport": {"type": "object"},
    "capabilities": {"type": "object"},
    "allowed_read_frames": {
      "type": "array",
      "items": {"type": "integer"}
    },
    "allowed_modbus_read_ranges": {
      "type": "array",
      "items": {"type": "object"}
    },
    "telemetry_map": {"type": "array"},
    "alarm_dictionary": {"type": "object"},
    "parameters": {"type": "array"},
    "topology": {"type": "object"},
    "inverter_link": {"type": "object"},
    "test_vectors": {"type": "array"},
    "connection_checklist": {
      "type": "array",
      "items": {"type": "object"}
    }
  }
}
