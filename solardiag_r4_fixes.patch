+      soh: soh,
+      remainingCapacity: base.remainingCapacity,
+      fullChargeCapacity: base.fullChargeCapacity,
+      cycleCount: base.cycleCount,
+      cellMeasurements: base.cellMeasurements,
+      temperatureSensors: base.temperatureSensors,
+      chargeMosfet: base.chargeMosfet,
+      dischargeMosfet: base.dischargeMosfet,
+      contactor: base.contactor,
+      balancingMask: base.balancingMask,
+      chargeCurrentLimit: base.chargeCurrentLimit,
+      dischargeCurrentLimit: base.dischargeCurrentLimit,
+      chargeVoltageLimit: base.chargeVoltageLimit,
+      rawAlarmBits: base.rawAlarmBits,
+      rawProtectionBits: base.rawProtectionBits,
+      linkStatus: base.linkStatus,
+      timestamp: base.timestamp,
+      staleAfter: base.staleAfter,
+    );
+
+TelemetrySnapshot _withCells(
+  TelemetrySnapshot base,
+  List<Measurement> cells,
+) => TelemetrySnapshot(
+  voltage: base.voltage,
+  current: base.current,
+  power: base.power,
+  soc: base.soc,
+  soh: base.soh,
+  remainingCapacity: base.remainingCapacity,
+  fullChargeCapacity: base.fullChargeCapacity,
+  cycleCount: base.cycleCount,
+  cellMeasurements: cells,
+  temperatureSensors: base.temperatureSensors,
+  chargeMosfet: base.chargeMosfet,
+  dischargeMosfet: base.dischargeMosfet,
+  contactor: base.contactor,
+  balancingMask: base.balancingMask,
+  chargeCurrentLimit: base.chargeCurrentLimit,
+  dischargeCurrentLimit: base.dischargeCurrentLimit,
+  chargeVoltageLimit: base.chargeVoltageLimit,
+  rawAlarmBits: base.rawAlarmBits,
+  rawProtectionBits: base.rawProtectionBits,
+  linkStatus: base.linkStatus,
+  timestamp: base.timestamp,
+  staleAfter: base.staleAfter,
+);
+
+void main() {
+  final base = ScenarioFactory.create(SimulationScenario.healthy).snapshot;
+  const diagnostics = BatteryDiagnostics();
+
+  test('SOH absent in the snapshot stays unavailable with a reason', () {
+    final assessment = diagnostics.analyze(base);
+    expect(assessment.stateOfHealth, isNull);
+    expect(assessment.reason, 'SOH_NOT_REPORTED_OR_DERIVABLE');
+  });
+
+  test('device-reported SOH is used and not discarded (R4 Z2)', () {
+    final reported = _withSoh(
+      base,
+      Measurement.value(91.5, '%', timestamp: base.timestamp),
+    );
+    final assessment = diagnostics.analyze(reported);
+    expect(assessment.stateOfHealth, 91.5);
+    expect(assessment.reason, 'SOH_DEVICE_REPORTED');
+  });
+
+  test('absent cells are counted and lower the confidence (R4 Z2)', () {
+    final cells = [...base.cellMeasurements];
+    cells[3] = Measurement.absent(
+      DataAbsenceReason.readFailed,
+      unit: 'V',
+      timestamp: base.timestamp,
+    );
+    final assessment = diagnostics.analyze(_withCells(base, cells));
+    final finding = assessment.findings.firstWhere(
+      (item) => item.code == 'CELL_DELTA',
+    );
+    expect(finding.evidence['cell_count_expected'], 16);
+    expect(finding.evidence['cell_count_used'], 15);
+    expect(finding.confidence, DiagnosticConfidence.medium);
+  });
+
+  test('complete cell data keeps high confidence', () {
+    final finding = diagnostics
+        .analyze(base)
+        .findings
+        .firstWhere((item) => item.code == 'CELL_DELTA');
+    expect(finding.evidence['cell_count_expected'], 16);
+    expect(finding.evidence['cell_count_used'], 16);
+    expect(finding.confidence, DiagnosticConfidence.high);
+  });
+
+  test('standard deviation uses a real square root', () {
+    final stdDev = diagnostics.cellStandardDeviation(base);
+    expect(stdDev, isNotNull);
+    expect(stdDev!, greaterThan(0));
+    expect(stdDev, lessThan(0.01));
+  });
+
+  test('architecture: core, diagnostics and integration never import the '
+      'simulator', () {
+    for (final directory in ['lib/core', 'lib/diagnostics', 'lib/integration']) {
+      for (final file in Directory(directory)
+          .listSync(recursive: true)
+          .whereType<File>()
+          .where((file) => file.path.endsWith('.dart'))) {
+        final source = file.readAsStringSync();
+        expect(
+          source.contains("simulator/"),
+          isFalse,
+          reason: '${file.path} must not depend on lib/simulator',
+        );
+      }
+    }
+  });
+}
diff --git a/test/r4_trust_test.dart b/test/r4_trust_test.dart
new file mode 100644
index 0000000..55853c8
--- /dev/null
+++ b/test/r4_trust_test.dart
@@ -0,0 +1,262 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:solardiag_pro/core/battery_models.dart';
+import 'package:solardiag_pro/protocol/capabilities.dart';
+import 'package:solardiag_pro/protocol/device_profile.dart';
+import 'package:solardiag_pro/trust/profile_integrity.dart';
+import 'package:solardiag_pro/trust/signed_tokens.dart';
+
+import 'support/test_signer.dart';
+
+DeviceProfile _profile({
+  Map<DeviceCapability, VerificationStatus> capabilities = const {},
+  List<ParameterAccess> access = const [],
+}) => DeviceProfile(
+  schemaVersion: 2,
+  id: 'test.profile',
+  category: 'bms',
+  manufacturer: 'Test',
+  family: 'Test',
+  models: const ['T1'],
+  firmwareRanges: const ['1.0'],
+  provenance: Provenance(
+    source: 'test',
+    documentId: 'doc',
+    retrievedOn: DateTime.utc(2026, 1, 1),
+    verifiedBy: 'tester',
+  ),
+  transport: const TransportRequirement(
+    interfaceType: InterfaceType.can,
+    listenOnlyByDefault: true,
+  ),
+  capabilities: CapabilitySet(capabilities),
+  allowedReadFrames: const {},
+  allowedModbusReadRanges: const [],
+  telemetryMap: const [],
+  alarmDictionary: const {},
+  parameters: [
+    for (var i = 0; i < access.length; i++)
+      ProfileParameterDefinition(
+        id: 'p$i',
+        label: const LocalizedText(en: 'Parameter', ar: 'معامل'),
+        access: access[i],
+        definition: const {},
+      ),
+  ],
+  topology: const {},
+  inverterLink: const {},
+  testVectors: const [],
+  connectionChecklist: const [],
+  simulated: false,
+);
+
+class _SequenceStore implements LibraryPackStore, RevocationSequenceStore {
+  LibraryPack? pack;
+  int sequence = 0;
+  @override
+  Future<LibraryPack?> load() async => pack;
+  @override
+  Future<void> save(LibraryPack value) async => pack = value;
+  @override
+  Future<int> loadHighestRevocationSequence() async => sequence;
+  @override
+  Future<void> saveHighestRevocationSequence(int value) async =>
+      sequence = value;
+}
+
+void main() {
+  group('R4 Y4: hasWriteCapability covers every claimed status', () {
+    for (final capability in [
+      DeviceCapability.writeParameter,
+      DeviceCapability.calibrate,
+    ]) {
+      for (final entry in {
+        VerificationStatus.verifiedHardware: true,
+        VerificationStatus.verifiedDocument: true,
+        VerificationStatus.communitySourced: true,
+        VerificationStatus.researchTarget: false,
+        VerificationStatus.simulated: false,
+        VerificationStatus.studioDraft: false,
+      }.entries) {
+        test('${capability.name} as ${entry.key.name} -> ${entry.value}', () {
+          final profile = _profile(capabilities: {capability: entry.key});
+          expect(profile.hasWriteCapability, entry.value);
+        });
+      }
+    }
+
+    test('read-only parameters alone do not imply write capability', () {
+      expect(
+        _profile(access: const [ParameterAccess.readOnly]).hasWriteCapability,
+        isFalse,
+      );
+    });
+
+    for (final access in [
+      ParameterAccess.readWrite,
+      ParameterAccess.writeOnly,
+      ParameterAccess.calibrate,
+      ParameterAccess.factory,
+    ]) {
+      test('a ${access.name} parameter implies write capability', () {
+        expect(_profile(access: [access]).hasWriteCapability, isTrue);
+      });
+    }
+
+    test('approval needs a non-empty hardware validation record id', () {
+      const withoutRecord = ProfileApproval(
+        lifecycleStage: 'published',
+        approvedByRole: 'approvalEngineer',
+        verifiedCapabilities: ['writeParameter'],
+      );
+      expect(
+        withoutRecord.isApprovedFor(DeviceCapability.writeParameter),
+        isFalse,
+      );
+      const withRecord = ProfileApproval(
+        lifecycleStage: 'published',
+        approvedByRole: 'approvalEngineer',
+        hardwareValidationRecordId: 'hw-001',
+        verifiedCapabilities: ['writeParameter'],
+      );
+      expect(
+        withRecord.isApprovedFor(DeviceCapability.writeParameter),
+        isTrue,
+      );
+    });
+  });
+
+  test('architecture: the registry has no unverified registration back door', () {
+    final source = File('lib/protocol/profile_registry.dart').readAsStringSync();
+    expect(source.contains('registerExternalProfile'), isFalse);
+  });
+
+  group('R4 Y5: revocation sequence and expiry', () {
+    late TestSigner signer;
+    late String simulatorProfile;
+    setUp(() async {
+      signer = await TestSigner.create(7);
+      simulatorProfile = await File(
+        'device_profiles/batteries/_simulated/solardiag_sim.json',
+      ).readAsString();
+    });
+
+    Future<LibraryPack> pack(int version) async {
+      final profile = await signer.signProfile(simulatorProfile);
+      final expires = DateTime.utc(2027);
+      final payload = {
+        'id': 'stable',
+        'version': version,
+        'min_app_version': 1,
+        'expires_at': expires.toIso8601String(),
+        'profile_hashes': {'sim': profile.contentHash},
+      };
+      return LibraryPack(
+        id: 'stable',
+        version: version,
+        minAppVersion: 1,
+        expiresAt: expires,
+        profileHashes: {'sim': profile.contentHash},
+        profiles: {'sim': profile},
+        signature: await signer.signPayload(payload),
+      );
+    }
+
+    Future<RevocationList> list(int sequence, {DateTime? validUntil}) async {
+      final unsigned = RevocationList(
+        sequence: sequence,
+        validUntil: validUntil,
+      );
+      return RevocationList(
+        sequence: sequence,
+        issuedAt: unsigned.issuedAt,
+        validUntil: unsigned.validUntil,
+        signature: await signer.signPayload(unsigned.payload),
+      );
+    }
+
+    LibrarySync sync(_SequenceStore store, {DateTime? now}) => LibrarySync(
+      verifier: Ed25519TrustVerifier(signer.publicKeyBytes),
+      appVersion: 2,
+      store: store,
+      clock: () => now ?? DateTime.utc(2026, 1, 5),
+    );
+
+    test('the same list can be applied again for a newer pack', () async {
+      final store = _SequenceStore();
+      final library = sync(store);
+      final revocations = await list(3);
+      expect(
+        await library.apply(
+          await pack(1),
+          now: DateTime.utc(2026),
+          revocations: revocations,
+        ),
+        isTrue,
+      );
+      expect(
+        await library.apply(
+          await pack(2),
+          now: DateTime.utc(2026),
+          revocations: revocations,
+        ),
+        isTrue,
+      );
+    });
+
+    test('a replayed older list is rejected after an app restart', () async {
+      final store = _SequenceStore();
+      expect(
+        await sync(store).apply(
+          await pack(1),
+          now: DateTime.utc(2026),
+          revocations: await list(5),
+        ),
+        isTrue,
+      );
+      expect(store.sequence, 5, reason: 'highest sequence must be persisted');
+
+      final restarted = sync(store); // new process: memory is empty
+      expect(
+        await restarted.apply(
+          await pack(2),
+          now: DateTime.utc(2026),
+          revocations: await list(4),
+        ),
+        isFalse,
+      );
+      expect(await restarted.refreshRevocations(await list(4)), isFalse);
+      expect(await restarted.refreshRevocations(await list(6)), isTrue);
+      expect(store.sequence, 6);
+    });
+
+    test('the persisted sequence file survives with FileLibraryPackStore',
+        () async {
+      final directory = await Directory.systemTemp.createTemp('r4_revseq_');
+      addTearDown(() => directory.delete(recursive: true));
+      final store = FileLibraryPackStore('${directory.path}/pack.json');
+      expect(await store.loadHighestRevocationSequence(), 0);
+      await store.saveHighestRevocationSequence(9);
+      expect(await store.loadHighestRevocationSequence(), 9);
+    });
+
+    test('an expired revocation list disables writes with a reason', () async {
+      final store = _SequenceStore();
+      final library = sync(store, now: DateTime.utc(2026, 1, 5));
+      await library.apply(
+        await pack(1),
+        now: DateTime.utc(2026),
+        revocations: await list(
+          1,
+          validUntil: DateTime.utc(2026, 1, 3),
+        ),
+      );
+      final installed = library.installed!;
+      expect(installed.isRevocationExpired, isTrue);
+      expect(installed.writeDisabledReason, contains('expired'));
+      expect(installed.profileCanWrite('anything'), isFalse);
+      expect(installed.showRevokedBanner, isTrue);
+    });
+  });
+}
