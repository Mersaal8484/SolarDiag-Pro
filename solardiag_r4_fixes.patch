+        final stream = ModbusRtuStreamDecoder();
+        final results = stream.add([...exceptionFrame(), ...normalFrame()]);
+        expect(results, hasLength(2));
+        expect(results[0], isA<ExceptionFrameResult>());
+        final exception = (results[0] as ExceptionFrameResult).exception;
+        expect(exception.functionCode, 3);
+        expect(exception.exceptionCode, 2);
+        expect(results[1], isA<SuccessFrameResult>());
+        expect((results[1] as SuccessFrameResult).frame.data, [2, 0, 42]);
