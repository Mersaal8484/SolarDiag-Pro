+    group('RTU stream decoder exception frames (X1)', () {
+      List<int> exceptionFrame() {
+        final body = [1, 0x83, 2];
+        final crc = ModbusCrc16.calculate(body);
+        return [...body, crc & 0xff, crc >> 8];
+      }
+
+      List<int> normalFrame() => const ModbusRtuCodec().encode(
